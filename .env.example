# Copy to .env and fill in. .env is gitignored; this template is not.
# These are read by api/chat.js when it runs on Vercel (or under `vercel dev`).
# The static site itself needs none of them — it falls back to local retrieval.

# Required only for LLM mode. Free key: https://openrouter.ai/keys
LLM_API_KEY=

# Optional — provider and model. Defaults to OpenRouter + a free open-weight model.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-oss-20b:free,google/gemma-4-26b-a4b-it:free

# Qwen lives on Groq: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3-32b

# Abuse caps
# RATE_PER_IP_HOUR=20
# RATE_GLOBAL_DAY=500
